# Supabase project credentials. Copy this file to `.env.local` and fill in
# the values from your Supabase dashboard:
#   Project Settings -> API
#
# Both values are safe to expose to the browser — the publishable key (also
# called "anon" key in older docs) is designed to be public and is gated by
# Row Level Security on the database.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
